@model EmployeeManagementSystem.Model.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<section class="page-header">
    <div>
        <h1>Delete Employee</h1>
        <p>Confirm that this employee record should be permanently removed.</p>
    </div>
</section>

<section class="panel">
    <div asp-validation-summary="ModelOnly"></div>

    <table>
        <tbody>
            <tr><th>Employee Id</th><td>@Model.EmployeeId</td></tr>
            <tr><th>Name</th><td>@Model.FirstName @Model.LastName</td></tr>
            <tr><th>Department</th><td>@Model.Department</td></tr>
            <tr><th>Designation</th><td>@Model.Designation</td></tr>
        </tbody>
    </table>

    <form asp-action="Delete" asp-route-id="@Model.EmployeeId" method="post">
        <div class="actions">
            <button type="submit" class="button danger">Delete</button>
            <a class="button secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
