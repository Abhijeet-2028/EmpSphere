@model EmployeeManagementSystem.Model.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<section class="panel">
    <h1>Application Error</h1>
    <p>The request could not be completed.</p>

    @if (Model.ShowRequestId)
    {
        <p><strong>Request Id:</strong> @Model.RequestId</p>
    }
</section>
